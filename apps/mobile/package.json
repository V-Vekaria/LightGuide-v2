{
  "name": "lightguide-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "export:web": "expo export --platform web --output-dir dist-web",
    "export:android": "expo export --platform android --output-dir dist-android",
    "test:e2e": "playwright test",
    "preview": "node scripts/preview.mjs",
    "postinstall": "node scripts/patch-sqlite-web.mjs",
    "dev": "node scripts/preview.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-document-picker": "^57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.20",
    "expo-sharing": "~57.0.18",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-ble-plx": "3.5.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sparticuz/chromium": "^152.0.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "decode-uri-component": "^0.5.0",
    "uuid": "^11.1.1"
  }
}
