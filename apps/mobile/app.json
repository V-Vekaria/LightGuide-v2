{
  "expo": {
    "name": "LightGuide",
    "slug": "lightguide-codex",
    "version": "0.2.0",
    "scheme": "lightguide-codex",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.lightguide.codex",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "versionCode": 6
    },
    "ios": {
      "bundleIdentifier": "com.lightguide.codex"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "LightGuide"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photographs to save with your lighting setup.",
          "cameraPermission": "Photograph your lighting setup.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-font",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": false
        }
      ]
    ]
  }
}
